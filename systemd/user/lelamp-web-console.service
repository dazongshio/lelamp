[Unit]
Description=LeLamp fixed web console on Tailscale
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/lemp/lelamp/lelamp_runtime
ExecStart=/home/lemp/lelamp/scripts/start_fixed_console.sh
Restart=always
RestartSec=3
StandardOutput=append:/home/lemp/lelamp/lelamp_runtime/workspace/.web_console_fixed.log
StandardError=append:/home/lemp/lelamp/lelamp_runtime/workspace/.web_console_fixed.log

[Install]
WantedBy=default.target
