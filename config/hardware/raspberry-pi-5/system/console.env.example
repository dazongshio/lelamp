# Public deployment paths and safe hardware defaults only.
# Copy into console.env only for a new deployment; never overwrite an existing
# private console.env. Add locally managed authentication separately.
# File values are read by systemd, not by shell source.
TMPDIR=/home/z/Project/lelamp-web/tmp
UV_CACHE_DIR=/home/z/Project/lelamp-web/tmp/uv-cache
OPENCLAW_ENABLE_HARDWARE=0
OPENCLAW_ENABLE_RGB=0
# Skip startup homing; hardware=0 remains the general motion gate.
LELAMP_STARTUP_HOME=0
# Existing by-id path on the verified servo adapter.
LELAMP_PORT=/dev/serial/by-id/usb-1a86_USB_Single_Serial_5B79031190-if00
OPENCLAW_MIC_DEVICE=plughw:CARD=A311,DEV=0
OPENCLAW_SPEAKER_DEVICE=plughw:CARD=A311,DEV=0
# /etc/lelamp/hardware.env is loaded later and selects /dev/lelamp-servo.
