# System service for a clone of this Git repository, separate from the live
# lelamp-web deployment layout. Review paths before installing manually.
# UV must already exist at the path below; prepare runtime dependencies first.
# This file is an example; apply_profile.py does not install the base service.
[Unit]
Description=LeLamp web console (repository layout)
After=network.target

[Service]
Type=simple
User=z
Group=z
SupplementaryGroups=dialout video audio
WorkingDirectory=/home/z/Project/lelamp
EnvironmentFile=/home/z/Project/lelamp/console.env
# Final public hardware profile overrides duplicate values in console.env.
EnvironmentFile=/etc/lelamp/hardware.env
ExecStart=/home/z/Project/lelamp/bin/uv run --offline --no-sync --project /home/z/Project/lelamp/lelamp_runtime --directory /home/z/Project/lelamp/lelamp_runtime openclaw_cli.py web-console --host 0.0.0.0 --port 8790 --projection-preview-port 8765
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
