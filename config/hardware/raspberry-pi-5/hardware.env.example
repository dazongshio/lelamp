# LeLamp OfficeAgentConfig variables; no API credentials belong in this file.
# Install the supplied udev rules before selecting /dev/lelamp-servo.
LELAMP_PORT=/dev/lelamp-servo
# Only servo IDs 1 and 2 responded to PING/READ; motion remains disabled.
OPENCLAW_ENABLE_HARDWARE=0
OPENCLAW_ENABLE_RGB=0
OPENCLAW_MIC_DEVICE=plughw:CARD=A311,DEV=0
OPENCLAW_SPEAKER_DEVICE=plughw:CARD=A311,DEV=0
# Projector settings are managed by the separate projector tool/service.
# Stable USB path: /dev/serial/by-id/usb-1a86_USB_Serial-if00-port0
# Serial: 9600 baud, 8N1. Video: CEA 1280x720 progressive, 60 Hz.
# Both horizontal and vertical flip match the verified installation.
