# Copy this file to .env.tingwu.local, fill in local-only values, then source it.
# Never paste real keys into chat, commits, issue trackers, screenshots, or evidence files.

# Use a freshly rotated Bailian/DashScope key.
# Do not use RAM AccessKey IDs such as LTAI*** here.
export DASHSCOPE_API_KEY='replace_with_new_rotated_key'

# Copy this from Bailian Console -> 应用管理 -> your Tingwu meeting app -> App ID / 应用 ID.
# The official tingwu-meeting examples use values shaped like tw_***.
# For this DashScope tingwu-meeting integration, use the Model Studio appId from the
# app configuration page, not the legacy Tingwu OpenAPI project AppKey.
export TINGWU_APP_ID='replace_with_bailian_app_id'

# Usually auto is correct. Use a concrete ALSA device such as plughw:2,0 if auto selects the wrong microphone.
export OPENCLAW_MIC_DEVICE=auto

# Keep official DashScope/Tingwu endpoints unless a test explicitly overrides them.
export TINGWU_HTTP_URL='https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation'
export TINGWU_WS_URL='wss://dashscope.aliyuncs.com/api-ws/v1/inference'

# Optional Tingwu meeting features. The runtime enables the core meeting analysis
# features by default: summary, speaker summary, key information, actions, Q&A,
# auto chapters, mind map, PPT extraction, text polish, and realtime agent events.
# Translation and custom prompt stay off unless explicitly configured.
export TINGWU_TRANSLATION_ENABLED=0
export TINGWU_TRANSLATION_TARGET_LANG='en'

# Create a hot-word phrase library in Tingwu/DashScope console, then put its
# phraseId here. TINGWU_HOT_WORDS is only kept as a local note for diagnostics.
export TINGWU_PHRASE_ID=''
export TINGWU_HOT_WORDS='LeLamp,OpenClaw,Qwen,通义听悟'

export TINGWU_MIND_MAP_ENABLED=1
export TINGWU_PPT_EXTRACTION_ENABLED=1
export TINGWU_TEXT_POLISH_ENABLED=1
export TINGWU_CUSTOM_PROMPT_ENABLED=0
export TINGWU_CUSTOM_PROMPT_MODEL='tingwu-turbo'
export TINGWU_CUSTOM_PROMPT_TRANS_TYPE='chat'
export TINGWU_CUSTOM_PROMPT='请按 项目决策、风险、待办、负责人、截止时间 输出会议结论。'
